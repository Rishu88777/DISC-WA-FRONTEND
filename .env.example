# Google Apps Script Web App URL (ends in /exec) — used server-side only, by
# api/track.js. Set as a plain (non-VITE_) env var in Vercel's project settings
# so it's never bundled into client JS. See google-apps-script/Code.gs and README.md.
# TRACKING_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec

# The PDF file that gets previewed/downloaded. Defaults to /public/School_Report.pdf.
VITE_PDF_URL=/School_Report.pdf
VITE_PDF_FILE_NAME=School_Report.pdf

# Branding
VITE_COMPANY_NAME=ABC Learning Institute
VITE_COMPANY_TAGLINE=Learn • Build • Grow
VITE_DOCUMENT_TITLE=Result & Certificate
VITE_SUPPORT_EMAIL=info@abclearning.com
VITE_SUPPORT_PHONE=+91 98765 43210
VITE_WEBSITE=www.abclearning.com
