# Google Apps Script Web App URL (ends in /exec). See google-apps-script/Code.gs and README.md.
VITE_TRACKING_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec

# The PDF file that gets previewed/downloaded. Defaults to /public/sample-document.pdf.
VITE_PDF_URL=/sample-document.pdf
VITE_PDF_FILE_NAME=document.pdf

# Branding
VITE_COMPANY_NAME=Knowledge Culture
VITE_DOCUMENT_TITLE=Your Document
