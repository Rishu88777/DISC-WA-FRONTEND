{
  "headers": [
    {
      "source": "/School_Report.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"School_Report.pdf\""
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
