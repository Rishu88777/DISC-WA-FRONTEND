# Google Apps Script Web App URL (ends in /exec) — used server-side only, by
# api/track.js. Set as a plain (non-VITE_) env var in Vercel's project settings
# so it's never bundled into client JS. See google-apps-script/Code.gs and README.md.
# TRACKING_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec

# The PDF file that gets previewed/downloaded. Defaults to /public/DICS_Admission_Notice.pdf.
VITE_PDF_URL=/DICS_Admission_Notice.pdf
VITE_PDF_FILE_NAME=DICS_Admission_Notice.pdf

# Branding
VITE_COMPANY_NAME=Delhi Institute of Computer Science (DICS)
VITE_COMPANY_TAGLINE=Educating the Next Generation
VITE_DOCUMENT_TITLE=Admission Notice
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_WEBSITE=
